# Stockgood production environment (copy to .env.production; do not commit secrets)

STOCKGOOD_DB_MODE=production
STOCKGOOD_AUTH_REQUIRED=true
STOCKGOOD_SESSION_SECRET=change-me-to-a-long-random-string
STOCKGOOD_COOKIE_SECURE=true
STOCKGOOD_CORS_ORIGINS=https://your.domain.example

# First boot creates this admin if users table is empty
STOCKGOOD_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
STOCKGOOD_BOOTSTRAP_ADMIN_PASSWORD=change-me-min-8-chars

# Optional legacy shared token (prefer user accounts)
# STOCKGOOD_ADMIN_TOKEN=

# Optional SMTP for申请状态邮件通知
# STOCKGOOD_NOTIFY_ENABLED=true
# STOCKGOOD_SMTP_HOST=smtp.example.com
# STOCKGOOD_SMTP_PORT=587
# STOCKGOOD_SMTP_USER=
# STOCKGOOD_SMTP_PASSWORD=
# STOCKGOOD_SMTP_FROM=noreply@example.com
# STOCKGOOD_SMTP_USE_TLS=true
