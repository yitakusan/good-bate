# Optional. Legacy shared staff secret (prefer user login):
#   X-Admin-Token: <same value>
# STOCKGOOD_ADMIN_TOKEN=

# Auth (auto = require when users exist or admin_token set)
# STOCKGOOD_AUTH_REQUIRED=true
# STOCKGOOD_SESSION_SECRET=dev-secret-change-me
# STOCKGOOD_COOKIE_SECURE=false
# STOCKGOOD_CORS_ORIGINS=*
# STOCKGOOD_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# STOCKGOOD_BOOTSTRAP_ADMIN_PASSWORD=changeme12

# Serve built SPA (production / Docker)
# STOCKGOOD_STATIC_DIR=

# SMTP notifications (optional)
# STOCKGOOD_NOTIFY_ENABLED=true
# STOCKGOOD_SMTP_HOST=
# STOCKGOOD_SMTP_PORT=587
# STOCKGOOD_SMTP_USER=
# STOCKGOOD_SMTP_PASSWORD=
# STOCKGOOD_SMTP_FROM=
# STOCKGOOD_SMTP_USE_TLS=true

# Customer apply deposit rate (0.3 = 30%)
# STOCKGOOD_DEPOSIT_RATE=0.3
