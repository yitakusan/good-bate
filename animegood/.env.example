ANIMEGOOD_DATABASE_PATH=data/animegood.sqlite
ANIMEGOOD_SOURCE_CONFIG_PATH=config/sources.json
ANIMEGOOD_IP_ALIAS_PATH=data/ip_aliases.json
ANIMEGOOD_REQUEST_TIMEOUT_SECONDS=20
ANIMEGOOD_SCRAPE_CONCURRENCY=3

# 公网部署务必设置；留空则本机开发不鉴权
# ANIMEGOOD_ADMIN_TOKEN=change-me

# 定时全量抓取间隔（小时）；0=关闭。VPS 建议 6～12
# ANIMEGOOD_SCRAPE_INTERVAL_HOURS=6
